{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/generate.ts": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/usage.ts": {
      "includeFiles": "server/**"
    }
  }
}
