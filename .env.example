# Supabase (server-side only — never expose service role key to the browser)
SUPABASE_URL=https://wvbcvnzclkvykhkpgkyh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: publishable key (not used by this app today)
SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# AWeber (server-side only — never expose to the browser)
# OAuth 2.0 bearer token with subscriber.write scope. See AWeber Labs: https://labs.aweber.com
AWEBER_ACCESS_TOKEN=your-oauth-access-token-here
# Numeric account ID from GET https://api.aweber.com/1.0/accounts (entries[].id)
AWEBER_ACCOUNT_ID=your-account-id-here
# List unique ID (e.g. awlist6966993) or numeric list ID from GET .../accounts/{accountId}/lists
AWEBER_LIST_ID=awlist6966993
# Local dev only: skip AWeber when credentials are missing (set to true)
AWEBER_DEV_BYPASS=false

# Server (local dev only)
PORT=5000
